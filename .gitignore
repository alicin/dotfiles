.local/bin/**
.local/bin/*
!.local/bin/scripts
*.zcomp*
*.code-profile
*.vsix
.DS_Store
.android/avd
.android/cache
config/atuin/*receipt*.json
config/ncspot/userstate.cbor
config/pacsea/lists
config/pacsea/logs

# Runtime state that lives inside otherwise-hand-authored config dirs.
# micro/ keeps whole copies of edited files under backups/ and buffers/ —
# including, at one point, a copy of toshy_config.py — so this is a leak risk,
# not just noise.
config/micro/backups
config/micro/buffers
# The `ali` launcher: layout.toml is hand-edited and tracked; these two are
# regenerated caches.
config/ali/apps_cache.toml
config/ali/frecency.toml
# Toshy's prefs DB was tracked and symlinked back into ~/.config/toshy, so the
# keymapper wrote runtime state straight into this working tree: it appends to
# mru_layouts (a trigger-trimmed rolling layout log) on every start, which made
# the file dirty after every login on every host, forever. config_preferences —
# the part that actually decides modifier behavior — is stable, but there is no
# way to track one table and ignore the other in a binary blob. Untracked
# 2026-08-07; ~/.config/toshy/ now holds a real file, not a link in here.
# The last tracked copy is recoverable:
#   git show 5aedf00d:config/toshy/toshy_user_preferences.sqlite > \
#     ~/.config/toshy/toshy_user_preferences.sqlite
config/toshy/toshy_user_preferences.sqlite
# Sunshine/Deskflow/FreeRDP were deliberately NOT imported — they hold TLS
# private keys. Listed here so a future `dotlink` of them fails loudly instead
# of quietly committing a key.
config/sunshine
config/Deskflow
config/freerdp
.brew_cask_index
btop.log
__pycache__/

# Apple-licensed. qshell used a patched SF Symbols build before moving to
# Framework7; kept ignored so a stray local copy can never be committed.
themes/fonts/SFSymbolsQS.otf

# Claude Code agent worktrees (transient, one git repo each)
.claude/worktrees/

# systemd enablement is machine state, not configuration. ~/.config/systemd is a
# symlink into this repo on h4l9000, so every `systemctl --user enable` used to
# write a symlink straight into the working tree -- and commit one machine's
# Sunshine/telemetry units into everyone else's checkout. The unit *files* stay
# tracked; which of them a given host enables is scripts/services.sh's job.
config/systemd/user/*.target.wants/

# fontconfig stamps a per-machine .uuid into every font directory it caches.
# Machine state, regenerated on demand, and it shows up dirty on every host.
themes/fonts/.uuid
