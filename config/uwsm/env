# UWSM session environment for Hyprland.
# Sourced by uwsm before starting the compositor, then exported to the
# systemd --user and D-Bus activation environments.

# Apps.
export TERMINAL="kitty"
export EDITOR="code"
export FILE_BROWSER="yazi"
export BROWSER="google-chrome-stable"
export MOZ_ENABLE_WAYLAND="1"

# Backends.
export SDL_VIDEODRIVER="wayland"
export CLUTTER_BACKEND="wayland"

# Qt.
export QT_QPA_PLATFORM="wayland;xcb"
export QT_AUTO_SCREEN_SCALE_FACTOR="1"
export QT_SCALE_FACTOR="1"
export QT_WAYLAND_DISABLE_WINDOWDECORATION="1"
export QT_QPA_PLATFORMTHEME="qt5ct"

# GDK / GTK.
export GDK_SCALE="1"
export GDK_BACKEND="wayland,x11,*"
export GSK_RENDERER="ngl"

# Electron.
export ELECTRON_OZONE_PLATFORM_HINT="wayland"

# XDG.
export XDG_CURRENT_DESKTOP="Hyprland"
export XDG_SESSION_TYPE="wayland"
export XDG_SESSION_DESKTOP="Hyprland"

# Cursor theme.
export HYPRCURSOR_THEME="rose-pine-hyprcursor"
export HYPRCURSOR_SIZE="32"
export XCURSOR_THEME="BreezeX-RosePine-Linux"
export XCURSOR_SIZE="32"

# ── GPU: mode-aware environment ─────────────────────────────────────────────
# Re-evaluated at every login. A supergfx mode switch (`supergfxctl -m ...`)
# always logs you out, so the right GPU setup is picked automatically on the way
# back in -- no daemon/hook needed.
#
# AQ_DRM_DEVICES (the compositor's GPU) MUST stay colon-free: it is ':'-delimited,
# and a by-path name contains colons -> Aquamarine "Found no gpus" -> crash loop.
# We point it at the colon-free ~/.config/hypr/igpu symlink (-> Intel card via the
# udev by-path link), which also survives card0/card1 renumbering.
#
# Game-GPU policy (revised 2026-08-21):
#   The host runs on the Intel iGPU. Always. The nvidia dGPU exists for exactly
#   one thing -- passthrough to the win11 guest (see vfio/) -- and sits at 0 W
#   the rest of the time. So there is no mode in which a host process should
#   land on it, and the old Hybrid arm, which pointed games AT nvidia via PRIME
#   offload, could only produce games that refuse to start: supergfxd
#   reactivates the nvidia Vulkan ICD in Hybrid, the loader then advertises a
#   GPU that is bound to vfio-pci, and vkCreateInstance dies with
#   ERROR_INCOMPATIBLE_DRIVER ("Found no drivers!"). Integrated, Vfio and Hybrid
#   are therefore all the same answer now.
#
#   AsusMuxDgpu stays as a safety net rather than a mode we use: the MUX routes
#   the panel to nvidia, so AQ_DRM_DEVICES must NOT point at the Intel node
#   there or the compositor finds no output at all.
#
# Per-app override: `igpu-run <cmd>` (bin/igpu-run, also a Steam launch option:
# `igpu-run %command%`). There is deliberately no dgpu-run any more.
#
# ALL of this is gated on supergfxctl actually being installed, i.e. on a hybrid
# Intel+nvidia ASUS box. On a single-GPU host (k3v1n: Radeon 780M) supergfxctl
# does not exist, `$_gfx` comes back empty, and the `*)` arm below would happily
# export nvidia PRIME vars plus an AQ_DRM_DEVICES pointing at ~/.config/hypr/igpu
# -- a symlink to *this* laptop's Intel by-path node, which resolves to nothing
# there. Aquamarine then reports "Found no gpus" and the compositor crash-loops.
# Leaving the whole block unset lets Mesa pick the only card present, which is
# the correct answer on any single-GPU machine.
if [ -x /usr/bin/supergfxctl ]; then
_gfx="$(/usr/bin/supergfxctl -g 2>/dev/null)"
case "$_gfx" in
  AsusMuxDgpu)
    unset AQ_DRM_DEVICES                           # nvidia drives the panel (MUX)
    export __GLX_VENDOR_LIBRARY_NAME="nvidia"
    export LIBVA_DRIVER_NAME="nvidia"
    unset VK_DRIVER_FILES VK_ICD_FILENAMES __EGL_VENDOR_LIBRARY_FILENAMES \
          MESA_VK_DEVICE_SELECT DRI_PRIME __NV_PRIME_RENDER_OFFLOAD __VK_LAYER_NV_optimus
    ;;
  *)  # Integrated / Vfio / Hybrid: the iGPU, whatever supergfxd thinks.
    export AQ_DRM_DEVICES="$HOME/.config/hypr/igpu"
    export __GLX_VENDOR_LIBRARY_NAME="mesa"        # GLX -> Intel
    export LIBVA_DRIVER_NAME="iHD"                 # VA-API video -> Intel

    # Vulkan: stop the nvidia ICD being loaded at all, rather than filtering it
    # out after the fact. MESA_VK_DEVICE_SELECT (what this used to do) runs as
    # an implicit layer and picks a device once the loader has already
    # initialised every ICD it found -- and initialising nvidia's against a GPU
    # that is bound to vfio-pci is the step that fails, with "Found no drivers!"
    # / ERROR_INCOMPATIBLE_DRIVER. It also hardcoded 8086:7d51, which is this
    # laptop and nothing else. Pinning the ICD is the same intent stated
    # generically and one layer earlier. Built from a glob and only exported if
    # it matched, so a renamed ICD degrades to the loader's own default rather
    # than to no Vulkan at all.
    # (MEASURED: a non-matching MESA_VK_DEVICE_SELECT does *not* empty the
    # device list -- it falls back -- so that part was never the danger.)
    _icd=""
    for _f in /usr/share/vulkan/icd.d/intel_icd*.json; do
      [ -e "$_f" ] && _icd="${_icd:+$_icd:}$_f"
    done
    if [ -n "$_icd" ]; then
      export VK_DRIVER_FILES="$_icd"               # loader >= 1.3.207
      export VK_ICD_FILENAMES="$_icd"              # older loaders; ignored above
    fi
    unset _icd _f

    # EGL the same way: glvnd reads 10_nvidia.json before 50_mesa.json, so
    # every EGL app tries the nvidia vendor library first and only falls through
    # to Mesa once loading it fails against a dGPU that is on vfio-pci.
    [ -e /usr/share/glvnd/egl_vendor.d/50_mesa.json ] && \
      export __EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/50_mesa.json

    # DRI_PRIME is NOT set: Mesa reads it as an offload-device selector and
    # rejects 0 outright ("Invalid value (0) for DRI_PRIME. Should be > 0"),
    # which it printed into every GL client on the system for nothing.
    unset MESA_VK_DEVICE_SELECT DRI_PRIME __NV_PRIME_RENDER_OFFLOAD __VK_LAYER_NV_optimus
    ;;
esac
unset _gfx
fi
