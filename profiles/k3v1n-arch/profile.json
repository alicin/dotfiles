{
  "name": "k3v1n-arch",
  "description": "Minisforum V3 convertible (Ryzen 7 8840U / Radeon 780M) running Arch Linux — primary dev machine",
  "hostname": "k3v1n",
  "os": "arch",
  "arch": "x86_64",
  "package_managers": {
    "pacman": {
      "enabled": true,
      "file": "pacman.txt"
    },
    "yay": {
      "enabled": true,
      "file": "aur.txt"
    },
    "flatpak": {
      "enabled": true,
      "file": "flatpak.txt"
    },
    "npm": {
      "enabled": true,
      "file": "npm.txt"
    }
  },
  "configs": [
    "atuin",
    "zsh",
    "bat",
    "btop",
    "htop",
    "lazygit",
    "gh",
    "hypr",
    "quickshell",
    "uwsm",
    "gtk-3.0",
    "gtk-4.0",
    "wofi",
    "fuzzel",
    "kitty",
    "yazi",
    "imv",
    "micro",
    "posting",
    "nvtop",
    "pavucontrol.ini",
    "code-flags.conf",
    "electron-flags.conf",
    "electron13-flags.conf",
    "electron25-flags.conf",
    "mimeapps.list"
  ],
  "dotfiles": [
    ".zshrc",
    ".gitconfig",
    ".editorconfig"
  ],
  "themes": [
    "fonts",
    "wallpapers"
  ],
  "scripts": {
    "pre_install": [
      "prepare.sh"
    ],
    "post_install": [
      "workspace.sh",
      "permissions.sh",
      "enable-multicore-build.sh",
      "toshy-install.sh",
      "services.sh",
      "minisforum-finalize.sh",
      "v3-audio-fix.sh",
      "finalize.sh"
    ]
  },
  "environment": {
    "BROWSER": "google-chrome-stable",
    "TERMINAL": "kitty",
    "XDG_SESSION_TYPE": "wayland"
  }
}
