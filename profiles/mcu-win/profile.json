{
  "name": "mcu-win",
  "description": "Desktop workstation running Windows",
  "hostname": "MCU-WIN",
  "os": "windows",
  "arch": "x86_64",
  "package_managers": {
    "winget": {
      "enabled": true,
      "file": "winget.txt"
    },
    "scoop": {
      "enabled": true,
      "file": "scoop.txt"
    }
  },
  "configs": ["vscode"],
  "dotfiles": [".gitconfig"],
  "themes": ["fonts"],
  "scripts": {
    "pre_install": [],
    "post_install": []
  },
  "environment": {
    "BROWSER": "msedge",
    "TERMINAL": "wt"
  },
  "features": {
    "wsl": true,
    "gaming": true,
    "virtualization": true
  }
}
