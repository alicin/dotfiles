<!--
  win11 — GPU-passthrough gaming VM for ASUS ROG Zephyrus G16 GU605CP (host: h4l9000)

  This file mirrors the KNOWN-WORKING live domain (dump reconciled 2026-07-05).
  Boots the EXISTING bare-metal Windows via whole-NVMe-controller passthrough (02:00.0).
  dGPU (01:00.0 + 01:00.1) is hot-plugged by the libvirt hook via `supergfxctl -m Vfio`.
  Viewed through Looking Glass over ivshmem-plain (host file /dev/shm/looking-glass).

  DEFINE:  virsh define vfio/win11.xml            (or run vfio/scripts/setup-host.sh)
  START:   vfio/scripts/game.sh                   (launches Looking Glass, shuts VM down on exit)

  hostdevs are managed='no' — the hook (prepare.sh) binds them to vfio-pci before QEMU opens them.
  Guest PCI addresses are intentionally omitted so libvirt auto-builds the PCIe topology.

  What's LIVE vs DEFERRED (uncomment when you want them):
    * INPUT: currently virtio mouse+keyboard (works through the Looking Glass client). The evdev
      passthrough blocks (Razer Naga + built-in keyboard, Ctrl+Ctrl grab) are commented out below —
      uncomment them, and add their nodes to qemu.conf cgroup_device_acl, when you do "Phase 4" input.
    * ANTI-CHEAT HARDENING: the hyperv <vendor_id> spoof and <kvm><hidden> are commented out
      ("keep it clean"). Uncomment if a title needs the hypervisor hidden — test on a burner account.
-->
<domain type="kvm">
  <name>win11</name>
  <!-- Must equal the <sysinfo> system uuid below. Generic placeholder (safe to commit);
       vfio/scripts/spoof-smbios.sh rewrites BOTH to the real hardware uuid in libvirt's copy only. -->
  <uuid>9f8e7d6c-5b4a-4321-9edc-ba9876543210</uuid>
  <metadata>
    <libosinfo:libosinfo xmlns:libosinfo="http://libosinfo.org/xmlns/libvirt/domain/1.0">
      <libosinfo:os id="http://microsoft.com/win/11"/>
    </libosinfo:libosinfo>
  </metadata>

  <!-- 16 GiB, THP-backed (host transparent_hugepage=always gives 2M pages); <allocation immediate>
       preallocates at start so it fails fast instead of OOMing mid-game. VFIO pins it for DMA anyway.
       Was 20 GiB until 2026-08-16: 20 GiB + ~1.5 GiB qemu overhead against 30 GiB of host RAM left
       too little for the desktop, and the guest was OOM-killed at the end of preallocation three
       times in a row (kernel: "Out of memory: Killed process ... qemu-system-x86 anon-rss:20561316kB"),
       with zram swap already at 15.5/15.8 GiB. 16 GiB leaves real headroom. Don't raise it back
       without checking `free -m` available first. -->
  <memory unit="KiB">16777216</memory>
  <currentMemory unit="KiB">16777216</currentMemory>
  <memoryBacking>
    <nosharepages/>
    <allocation mode="immediate"/>
  </memoryBacking>

  <!-- 6 vCPUs pinned 1:1 to the P-cores (0-5); emulator + iothread on E-cores (6-7). No HT. -->
  <vcpu placement="static">6</vcpu>
  <iothreads>1</iothreads>
  <cputune>
    <vcpupin vcpu="0" cpuset="0"/>
    <vcpupin vcpu="1" cpuset="1"/>
    <vcpupin vcpu="2" cpuset="2"/>
    <vcpupin vcpu="3" cpuset="3"/>
    <vcpupin vcpu="4" cpuset="4"/>
    <vcpupin vcpu="5" cpuset="5"/>
    <emulatorpin cpuset="6-7"/>
    <iothreadpin iothread="1" cpuset="6-7"/>
  </cputune>

  <!-- SMBIOS spoof: report an ASUS ROG Zephyrus G16, not QEMU/Bochs. Generic-but-valid defaults
       (safe to commit). For MAX fidelity run vfio/scripts/spoof-smbios.sh AFTER defining — it writes
       this machine's REAL serials/uuid into libvirt's private copy only (never into this file). -->
  <sysinfo type="smbios">
    <bios>
      <entry name="vendor">American Megatrends International, LLC.</entry>
      <entry name="version">GU605CP.320</entry>
      <entry name="date">01/15/2025</entry>
    </bios>
    <system>
      <entry name="manufacturer">ASUSTeK COMPUTER INC.</entry>
      <entry name="product">ROG Zephyrus G16 GU605CP_GU605CP</entry>
      <entry name="version">1.0</entry>
      <entry name="serial">M0N0CV00SYS000</entry>
      <entry name="uuid">9f8e7d6c-5b4a-4321-9edc-ba9876543210</entry>
      <entry name="sku">ROG Zephyrus G16 GU605CP_GU605CP</entry>
      <entry name="family">ROG Zephyrus G16</entry>
    </system>
    <baseBoard>
      <entry name="manufacturer">ASUSTeK COMPUTER INC.</entry>
      <entry name="product">GU605CP</entry>
      <entry name="version">1.0</entry>
      <entry name="serial">M0N0CV00BRD000</entry>
    </baseBoard>
    <chassis>
      <entry name="manufacturer">ASUSTeK COMPUTER INC.</entry>
      <entry name="version">1.0</entry>
      <entry name="serial">M0N0CV00CHS000</entry>
    </chassis>
    <oemStrings>
      <entry>_ASUS_</entry>
    </oemStrings>
  </sysinfo>

  <os>
    <type arch="x86_64" machine="q35">hvm</type>
    <!-- Secure Boot OVMF (Win11 + anti-cheat attestation). Enroll MS keys into the VARS file with
         vfio/scripts/enroll-secureboot.sh if a title requires enrolled keys. -->
    <loader readonly="yes" secure="yes" type="pflash" format="raw">/usr/share/edk2/x64/OVMF_CODE.secboot.4m.fd</loader>
    <nvram template="/usr/share/edk2/x64/OVMF_VARS.4m.fd" format="raw">/var/lib/libvirt/qemu/nvram/win11_VARS.fd</nvram>
    <bootmenu enable="yes" timeout="4000"/>
    <smbios mode="sysinfo"/>
  </os>

  <features>
    <acpi/>
    <apic/>
    <!-- SMM required for Secure Boot -->
    <smm state="on"/>
    <hyperv mode="custom">
      <relaxed state="on"/>
      <vapic state="on"/>
      <spinlocks state="on" retries="8191"/>
      <vpindex state="on"/>
      <runtime state="on"/>
      <synic state="on"/>
      <stimer state="on">
        <direct state="on"/>
      </stimer>
      <reset state="on"/>
      <frequencies state="on"/>
      <reenlightenment state="on"/>
      <tlbflush state="on"/>
      <ipi state="on"/>
      <!-- ANTI-CHEAT (optional): spoof the hypervisor vendor id so guest "is this KVM?" checks see
           gibberish while keeping the enlightenments anti-cheats expect. NOT evmcs (keeps APICv). -->
      <!-- <vendor_id state="on" value="AuthenticAMD"/> -->
    </hyperv>
    <!-- ANTI-CHEAT (optional): hide the KVM CPUID leaf. Leave off unless a title needs it. -->
    <!-- <kvm><hidden state="on"/></kvm> -->
    <vmport state="off"/>
    <ioapic driver="kvm"/>
  </features>

  <cpu mode="host-passthrough" check="none" migratable="off">
    <topology sockets="1" dies="1" cores="6" threads="1"/>
    <cache mode="passthrough"/>
    <feature policy="require" name="invtsc"/>
    <!-- Cap guest physical-address width. The RTX 5070's 8 GiB 64-bit BAR + the ivshmem region must
         both land inside a width vfio can DMA-map. Empirically limit=39 works on this box; higher
         (42) put the BAR where vfio_container_dma_map failed (-22) and QEMU crashed on start.
         DO NOT raise this without re-testing a cold VM start. -->
    <maxphysaddr mode="passthrough" limit="39"/>
  </cpu>

  <clock offset="localtime">
    <timer name="rtc" tickpolicy="catchup"/>
    <timer name="pit" tickpolicy="delay"/>
    <timer name="hpet" present="no"/>
    <timer name="hypervclock" present="yes"/>
  </clock>

  <on_poweroff>destroy</on_poweroff>
  <!-- NOTE: with 'restart', libvirt relaunches the domain on any guest reboot — and Windows
       auto-restarts on bugcheck. That is what turns a single nvlddmkm failure into an unbreakable
       boot loop when a display is plugged into the dGPU's HDMI (seen 2026-08-16). Switch to
       'destroy' to stop the VM instead, so the BSOD stays readable while debugging. -->
  <on_reboot>restart</on_reboot>
  <on_crash>destroy</on_crash>
  <pm>
    <suspend-to-mem enabled="no"/>
    <suspend-to-disk enabled="no"/>
  </pm>

  <devices>
    <emulator>/usr/bin/qemu-system-x86_64</emulator>

    <!-- No <disk> for the OS: the whole Samsung NVMe controller (02:00.0) is passed through below
         and carries the existing Windows install + its own EFI System Partition. -->

    <!-- virtio-win ISO for installing NetKVM / guest tools from inside Windows. Detach once done. -->
    <disk type="file" device="cdrom">
      <driver name="qemu" type="raw"/>
      <source file="/var/lib/libvirt/images/virtio-win.iso"/>
      <target dev="sdb" bus="sata"/>
      <readonly/>
    </disk>

    <controller type="usb" index="0" model="qemu-xhci" ports="8"/>
    <controller type="pci" index="0" model="pcie-root"/>
    <controller type="virtio-serial" index="0"/>
    <controller type="sata" index="0"/>

    <!-- virtio NIC (vhost-net). MAC uses an ASUSTeK OUI (not QEMU's 52:54:00) for anti-detection. -->
    <interface type="network">
      <mac address="04:d4:c4:11:22:33"/>
      <source network="default"/>
      <model type="virtio"/>
    </interface>

    <!-- ===================== INPUT ===================== -->
    <!-- LIVE: virtio mouse + keyboard (routed through the Looking Glass client). NO <input type=
         'tablet'> (it forces SPICE and breaks the FPS cursor). -->
    <input type="mouse" bus="virtio"/>
    <input type="keyboard" bus="virtio"/>
    <!-- DEFERRED "Phase 4" low-latency evdev passthrough. To enable: uncomment these, and add the
         three node paths to cgroup_device_acl in /etc/libvirt/qemu.conf (see setup-host.sh). The
         built-in keyboard grabs ALL evdev nodes together; toggle host<->guest with both Ctrl keys.
    <input type="evdev">
      <source dev="/dev/input/by-id/usb-Razer_Razer_Naga_V2_HyperSpeed_000000000000-event-mouse"/>
    </input>
    <input type="evdev">
      <source dev="/dev/input/by-id/usb-Razer_Razer_Naga_V2_HyperSpeed_000000000000-if02-event-kbd"/>
    </input>
    <input type="evdev">
      <source dev="/dev/input/by-path/platform-i8042-serio-0-event-kbd" grab="all" grabToggle="ctrl-ctrl" repeat="on"/>
    </input>
    -->

    <!-- ===================== DISPLAY / AUDIO ===================== -->
    <!-- SPICE carries Looking Glass native audio + clipboard. Keep it even after <video> is 'none'. -->
    <graphics type="spice" autoport="yes">
      <listen type="address"/>
      <image compression="off"/>
      <gl enable="no"/>
    </graphics>
    <sound model="ich9"/>
    <audio id="1" type="spice"/>
    <!-- vga stays as the OVMF/boot console AND the surface Looking Glass captures. (Switching to
         <model type='none'/> requires a guest-side virtual display that survives headless boot; the
         MTT Virtual Display Driver in the guest provides the 2560x1600@240 surface LG captures.)

         TRIED AND REVERTED 2026-08-16: setting this to 'none' to cut a display path left the guest
         with ZERO heads when run without a monitor on the dGPU's HDMI — the VDD was then the only
         possible head, and it did not come up. Windows booted to nothing: no LG session, no guest
         agent, no DHCP lease, and it would not even answer an ACPI shutdown. There is also no
         host-side view of the guest with 'none' (virsh screenshot / SPICE have no display device to
         capture), so it is a bad state to debug from. Do not set 'none' until the VDD is proven to
         come up on its own, and keep a monitor attached the first time you try. -->
    <video>
      <model type="vga" vram="16384" heads="1"/>
    </video>
    <channel type="spicevmc">
      <target type="virtio" name="com.redhat.spice.0"/>
    </channel>
    <!-- qemu-ga channel: lets the host run commands/queries in the guest without a login
         (virsh qemu-agent-command / guest-exec). The Windows qemu-ga service ships with the
         virtio-win guest tools and picks the port up via PnP. -->
    <channel type="unix">
      <target type="virtio" name="org.qemu.guest_agent.0"/>
    </channel>

    <!-- ===================== TPM ===================== -->
    <tpm model="tpm-crb">
      <backend type="emulator" version="2.0"/>
    </tpm>

    <!-- ===================== PASSTHROUGH ===================== -->
    <!-- NVIDIA dGPU (Blackwell RTX 5070). managed='no' — the hook binds it via `supergfxctl -m Vfio`.
         Uncomment <rom .../> only if the guest driver reports Code 43 (muxless vBIOS shadow). -->
    <hostdev mode="subsystem" type="pci" managed="no">
      <source>
        <address domain="0x0000" bus="0x01" slot="0x00" function="0x0"/>
      </source>
      <!-- <rom bar="on" file="/var/lib/libvirt/vbios/nvidia_patched.rom"/> -->
    </hostdev>
    <!-- dGPU HDMI/DP audio function -->
    <hostdev mode="subsystem" type="pci" managed="no">
      <source>
        <address domain="0x0000" bus="0x01" slot="0x00" function="0x1"/>
      </source>
    </hostdev>
    <!-- Whole Samsung NVMe controller (02:00.0) = native disk, boots bare-metal Windows.
         managed='no' — the hook binds it to vfio-pci AFTER unmounting /mnt/fat. -->
    <hostdev mode="subsystem" type="pci" managed="no">
      <source>
        <address domain="0x0000" bus="0x02" slot="0x00" function="0x0"/>
      </source>
    </hostdev>

    <!-- action='none', NOT 'reset'. This watchdog was added to the live domain outside this repo and
         set to 'reset'; combined with <on_reboot>restart</on_reboot> it made any guest stall relaunch
         the VM forever. Keep it at 'none' unless you actually want automatic recovery. -->
    <watchdog model="itco" action="none"/>

    <memballoon model="none"/>

    <!-- ===================== Looking Glass shared buffer ===================== -->
    <!-- Native ivshmem-plain: host file is /dev/shm/looking-glass (created 0660 ali:kvm by the
         tmpfiles.d rule that setup-host.sh installs, so qemu can write it and the LG client can read
         it). size MUST cover the framebuffer: 128 MiB is plenty for 2560x1600 SDR. Client reads it
         via `shmFile=/dev/shm/looking-glass` in ~/.config/looking-glass/client.ini. -->
    <shmem name="looking-glass">
      <model type="ivshmem-plain"/>
      <size unit="M">128</size>
    </shmem>
  </devices>
</domain>
